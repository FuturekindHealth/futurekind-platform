# FutureKind environment example.
#
# Copy to `.env` and replace every angle-bracket value. Nothing in this file is a
# working credential or a real host: `.env.example` is committed, and an example
# that carries a usable key or an internal address becomes the thing a public
# repository knows about your installation.
#
# Generate credentials rather than typing them:
#
#   openssl rand -hex 32
#
# and keep one per purpose — the LiteLLM master key, the Gateway API keys and the
# Open WebUI signing secret are three different secrets that a copied-and-pasted
# habit turns into one.

TZ=Asia/Kolkata

POSTGRES_DB=futurekind

POSTGRES_USER=futurekind

POSTGRES_PASSWORD=<generated: openssl rand -hex 32>

# Where this installation keeps its data. Synology's Docker share is the default
# because that is the hardware this platform is aimed at; on any other host, point
# it at a directory the containers can write and back up.
FK_RUNTIME=/volume1/docker/futurekind/runtime

# The Ollama host LiteLLM addresses by alias. Shape, not an address — this is your
# inference box on your ward network.
#
# There is deliberately no OLLAMA_SECONDARY. `ProviderRegistry` holds one key per
# provider, so primary/secondary endpoint failover cannot be expressed here
# (ADR-0002); an unused second URL in this file read as a capability the deployment
# does not have. Failover between backends is LiteLLM's configuration to own.
OLLAMA_PRIMARY=http://<host-running-ollama>:11434

# LiteLLM's master key. The Gateway presents it to LiteLLM and no application ever
# sees it, so it must not be reused as an application credential.
LITELLM_MASTER_KEY=<generated: openssl rand -hex 32>

# --- FutureKind Gateway ---------------------------------------------------

# What an application (and the interface) presents to the Gateway. Comma- or
# space-separated; to rotate, add the new key, redeploy, then remove the old one.
# Treat this as a secret with the same rotation discipline as the master key: it is
# the only thing between a caller and clinical AI work.
FK_GATEWAY_API_KEYS=<generated: openssl rand -hex 32>

# Open WebUI's own signing secret, unrelated to any AI credential.
OPENWEBUI_SECRET_KEY=<generated: openssl rand -hex 32>

# Everything else the Gateway reads is set by compose.yaml, not here. Outside
# Docker these are the sixteen variables it looks for, all optional except the
# API keys, and none of them guessed at:

#   FK_GATEWAY_HOST                          0.0.0.0
#   FK_GATEWAY_PORT                          8100
#   FK_GATEWAY_MODELS_PATH                   discovered from the checkout
#   FK_GATEWAY_DEFAULT_CAPABILITY            default
#   FK_GATEWAY_REQUIRE_AUTH                  true
#   FK_GATEWAY_API_KEYS                      required in practice
#   FK_GATEWAY_REQUEST_TIMEOUT_SECONDS       120
#   FK_GATEWAY_MAX_MESSAGES                  100
#   FK_GATEWAY_MAX_CONTENT_CHARS             32000
#   FK_GATEWAY_MAX_COMPLETION_TOKENS         8192
#   FK_GATEWAY_LOG_LEVEL                     INFO
#   FK_GATEWAY_JSON_LOGS                     true
#   FK_GATEWAY_SERVICE_NAME                  futurekind-gateway
#   FK_GATEWAY_LITELLM_BASE_URL              no default: never invents an endpoint
#   FK_GATEWAY_LITELLM_API_KEY               LiteLLM's master key, not a Gateway key
#   FK_GATEWAY_LITELLM_CONFIG                discovered from the checkout
